RECOVERY_ERROR = "launchd recovery is uncertain; managed files were preserved"

SCHEMA = {
    "type": "object",
    "properties": {
        "host": {"type": "string", "title": "SSH host alias",
                 "description": "An existing SSH alias with trusted host key and working BatchMode authentication."},
        "remote_directory": {"type": "string", "title": "Remote managed directory",
                             "description": "Absolute project path ending in .buzz-ssh-provider; created mode 0700."},
        "runtime_command": {"type": "string", "title": "Remote Buzz runtime",
                            "description": "Executable name on the remote PATH, or an absolute executable path on that host.", "default": "buzz-acp"}
    },
    "required": ["host", "remote_directory"]
}
BOOT = "import sys,base64;src=base64.b64decode(sys.stdin.buffer.readline());exec(compile(src,'<buzz-ssh-helper>','exec'),{'__name__':'__main__','_SOURCE':src})"

def respond(request):
    if not isinstance(request, dict):
        return {"ok": False, "error": "request must be an object"}
    if request.get("op") == "info":
        return {"ok": True, "name": "ssh", "version": "0.1.0",
                "protocol_version": 1,
                "description": "Prototype: native macOS agent over existing SSH and launchd",
                "config_schema": SCHEMA}
    if request.get("op") != "deploy":
        return {"ok": False, "error": "unsupported operation"}
    config = request.get("provider_config")
    if not isinstance(config, dict) or set(config) - set(SCHEMA["properties"]):
        return {"ok": False, "error": "invalid provider configuration"}
    host = config.get("host")
    if not isinstance(host, str) or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.-]{0,127}", host):
        return {"ok": False, "error": "host must be an SSH alias"}
    if not isinstance(request.get("agent"), dict):
        return {"ok": False, "error": "agent payload is required"}
    remote_command = "python3 -c " + shlex.quote(BOOT)
    argv = ["ssh", "-T", "-o", "BatchMode=yes", "-o", "NumberOfPasswordPrompts=0",
            "-o", "StrictHostKeyChecking=yes", "-o", "ConnectTimeout=10",
            "--", host, remote_command]
    wire = base64.b64encode(REMOTE.encode()) + b"\n" + json.dumps(request, separators=(",", ":")).encode()
    try:
        result = subprocess.run(argv, input=wire, capture_output=True, timeout=90)
    except (OSError, subprocess.TimeoutExpired):
        return {"ok": False, "error": "SSH transport failed; check host trust, authentication and reachability"}
    if result.returncode or len(result.stdout) > 65536:
        return {"ok": False, "error": "SSH deployment failed; check remote Python and launchd availability"}
    try:
        response = json.loads(result.stdout)
    except (UnicodeDecodeError, ValueError):
        return {"ok": False, "error": "remote helper returned an invalid response"}
    if not isinstance(response, dict) or not isinstance(response.get("ok"), bool):
        return {"ok": False, "error": "remote helper returned an invalid response"}
    if response["ok"]:
        agent_id = response.get("agent_id")
        if not isinstance(agent_id, str) or not re.fullmatch(r"local\.buzz\.ssh\.[0-9a-f]{20}", agent_id):
            return {"ok": False, "error": "remote helper returned an invalid agent id"}
        return {"ok": True, "agent_id": agent_id}
    safe_errors = {
        "invalid agent identity", "relay_url must be a valid ws or wss URL",
        "desktop-resolved launch data is required", "launch.owner_pubkey is required for intentional stop",
        "relay-mesh agents cannot be deployed to SSH", "launch environment contains an invalid entry",
        "presence suppression is forbidden for remote agents", "launch.args must be strings without commas",
        "invalid respond_to mode", "respond_to_allowlist must contain public keys",
        "remote project directory must exist and belong to the SSH user",
        "managed directory is not owned by the SSH user", "managed directory must have mode 0700",
        "managed directory cannot be a symlink", "managed subdirectory is unsafe",
        "existing managed state is unreadable", "existing managed state has a different owner",
        "existing managed files are not private", "existing managed files are incomplete",
        "existing managed plist is unreadable", "existing managed plist has a different owner",
        "existing immutable helper is unsafe", "managed path is a symlink",
        "existing launchd label is not owned by this provider",
        "managed lock is a symlink", "launchd GUI domain is unavailable",
        "agent is already running with different configuration; stop it before redeploy",
        "could not unload stopped managed job", "launchd could not bootstrap the managed job",
        "launchd did not retain the managed job", "managed runtime exited during startup",
        "managed runtime did not become stably running",
        "deployment failed and prior managed job could not be restored",
        RECOVERY_ERROR,
        "remote PATH is unsafe", "runtime_command is unavailable on the remote PATH",
        "runtime_command is unavailable on the remote host",
        "runtime_command has an invalid interpreter",
        "runtime_command has an unsupported env interpreter",
        "runtime_command interpreter is unavailable on the managed PATH",
        "runtime_command interpreter is unavailable on the remote host",
        "launch.command is unavailable on the remote PATH",
        "launch.command must be a command name on the remote PATH",
        "launch.command has an invalid interpreter",
        "launch.command has an unsupported env interpreter",
        "launch.command interpreter is unavailable on the managed PATH",
        "launch.command interpreter is unavailable on the remote host",
        "runtime_command must be a command name on the remote PATH"
    }
    error = response.get("error")
    return {"ok": False, "error": error if error in safe_errors else "remote deployment refused"}

def main():
    try:
        request = json.load(sys.stdin)
        result = respond(request)
    except (ValueError, UnicodeDecodeError):
        result = {"ok": False, "error": "invalid JSON request"}
    print(json.dumps(result, separators=(",", ":")))

if __name__ == "__main__":
    main()
