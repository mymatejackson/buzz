#!/usr/bin/env python3
"""Buzz provider protocol v1: SSH to a native macOS launchd job.

One staged file is intentional: Buzz copies only the provider executable before
calling info and deploy. No credential or machine setting is bundled here.
"""
import base64
import json
import re
import shlex
import subprocess
import sys

REMOTE = r'''
import fcntl
import hashlib
import json
import os
from pathlib import Path
import plistlib
import re
import shlex
import shutil
import stat
import subprocess
import sys
import tempfile
import time
from urllib.parse import urlparse

ALPHABET = "qpzry9x8gf2tvdw0s3jn54khce6mua7l"
FIELD = 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFEFFFFFC2F
GX = 55066263022277343669578718895168534326250603453777594175500187360389116729240
GY = 32670510020758816978083085130507043184471273380659243275938904335757337482424
RESERVED = {"BUZZ_RELAY_URL", "BUZZ_PRIVATE_KEY", "NOSTR_PRIVATE_KEY",
            "BUZZ_AUTH_TAG", "BUZZ_ACP_AGENT_OWNER", "BUZZ_ACP_AGENT_COMMAND",
            "BUZZ_ACP_AGENT_ARGS", "BUZZ_ACP_RESPOND_TO",
            "BUZZ_ACP_RESPOND_TO_ALLOWLIST", "BUZZ_ACP_MCP_COMMAND",
            "BUZZ_ACP_EXIT_AFTER_INACTIVITY", "BUZZ_MANAGED_AGENT_START_NONCE",
            "HOME", "XDG_CONFIG_HOME", "XDG_CACHE_HOME", "XDG_DATA_HOME",
            "BUZZ_AGENT_CONFIG_DIR", "CODEX_HOME", "CLAUDE_CONFIG_DIR", "TMPDIR", "PATH"}
START_TIMEOUT_SECONDS = 1.0
START_STABILITY_SECONDS = 0.25
ENV_KEY = re.compile(r"[A-Za-z_][A-Za-z0-9_]*\Z")
HEX64 = re.compile(r"[0-9a-fA-F]{64}\Z")
LABEL = re.compile(r"local\.buzz\.ssh\.[0-9a-f]{20}\Z")
RECOVERY_ERROR = "launchd recovery is uncertain; managed files were preserved"

class RecoveryRequired(ValueError):
    pass


def fail(message):
    raise ValueError(message)

def decode_nsec(value):
    if not isinstance(value, str) or value.lower() != value or not value.startswith("nsec1"):
        fail("invalid agent identity")
    data = [ALPHABET.find(c) for c in value[5:]]
    if len(data) < 7 or min(data) < 0:
        fail("invalid agent identity")
    chk = 1
    for n in [3, 3, 3, 3, 0, 14, 19, 5, 3] + data:
        top = chk >> 25
        chk = ((chk & 0x1ffffff) << 5) ^ n
        for i, gen in enumerate((0x3b6a57b2, 0x26508e6d, 0x1ea119fa, 0x3d4233dd, 0x2a1462b3)):
            if (top >> i) & 1:
                chk ^= gen
    if chk != 1:
        fail("invalid agent identity")
    acc = bits = 0
    raw = bytearray()
    for n in data[:-6]:
        acc = (acc << 5) | n
        bits += 5
        if bits >= 8:
            bits -= 8
            raw.append((acc >> bits) & 255)
    if len(raw) != 32 or bits >= 5 or ((acc << (8 - bits)) & 255):
        fail("invalid agent identity")
    scalar = int.from_bytes(raw, "big")
    if not 1 <= scalar < 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFEBAAEDCE6AF48A03BBFD25E8CD0364141:
        fail("invalid agent identity")
    return scalar

def pubkey(scalar):
    def add(a, b):
        if a is None:
            return b
        if b is None:
            return a
        if a[0] == b[0] and (a[1] + b[1]) % FIELD == 0:
            return None
        slope = ((3 * a[0] * a[0]) * pow(2 * a[1], -1, FIELD)
                 if a == b else (b[1] - a[1]) * pow((b[0] - a[0]) % FIELD, -1, FIELD)) % FIELD
        x = (slope * slope - a[0] - b[0]) % FIELD
        return x, (slope * (a[0] - x) - a[1]) % FIELD
    result = None
    point = GX, GY
    while scalar:
        if scalar & 1:
            result = add(result, point)
        point = add(point, point)
        scalar >>= 1
    return f"{result[0]:064x}"

def safe_root(value):
    if not isinstance(value, str) or any(c in value for c in ("\0", "\r", "\n")):
        fail("remote_directory must be an absolute path")
    path = Path(value)
    if not path.is_absolute() or path.name != ".buzz-ssh-provider" or ".." in path.parts:
        fail("remote_directory must end in .buzz-ssh-provider inside a project")
    parent = path.parent
    if not parent.is_dir() or parent.is_symlink() or parent.stat().st_uid != os.getuid():
        fail("remote project directory must exist and belong to the SSH user")
    path = parent.resolve() / path.name
    if path.is_symlink():
        fail("managed directory cannot be a symlink")
    if path.exists():
        if not path.is_dir() or path.stat().st_uid != os.getuid():
            fail("managed directory is not owned by the SSH user")
        if stat.S_IMODE(path.stat().st_mode) & 0o077:
            fail("managed directory must have mode 0700")
    return path

def deployment_path():
    raw = os.environ.get("PATH", "/usr/bin:/bin:/usr/sbin:/sbin")
    parts = raw.split(":")
    if not parts or any(not part or not Path(part).is_absolute() for part in parts):
        fail("remote PATH is unsafe")
    return ":".join(dict.fromkeys(parts))

def command(value, label, path_value, allow_absolute=False):
    if allow_absolute and isinstance(value, str) and Path(value).is_absolute():
        path = Path(value)
        if not path.is_file() or not os.access(path, os.X_OK):
            fail(label + " is unavailable on the remote host")
        return str(path.resolve())
    if not isinstance(value, str) or not re.fullmatch(r"[A-Za-z][A-Za-z0-9_.+-]*", value):
        fail(label + " must be a command name on the remote PATH")
    found = shutil.which(value, path=path_value)
    if not found:
        fail(label + " is unavailable on the remote PATH")
    return str(Path(found).resolve())

def preflight_executable(value, env, label):
    path = Path(value)
    if not path.is_absolute() or not path.is_file() or not os.access(path, os.X_OK):
        fail(label + " is unavailable on the remote host")
    try:
        with path.open("rb") as source:
            header = source.read(256)
    except OSError:
        fail(label + " is unavailable on the remote host")
    if not header.startswith(b"#!"):
        return
    try:
        words = shlex.split(header.splitlines()[0][2:].decode("utf-8"))
    except (UnicodeDecodeError, ValueError):
        fail(label + " has an invalid interpreter")
    if not words:
        fail(label + " has an invalid interpreter")
    if words[0] == "/usr/bin/env":
        if len(words) != 2 or words[1].startswith("-"):
            fail(label + " has an unsupported env interpreter")
        interpreter = shutil.which(words[1], path=env["PATH"])
        if not interpreter or not os.access(interpreter, os.X_OK):
            fail(label + " interpreter is unavailable on the managed PATH")
    elif not Path(words[0]).is_absolute() or not Path(words[0]).is_file() or not os.access(words[0], os.X_OK):
        fail(label + " interpreter is unavailable on the remote host")

def env_for(agent, work_dir, path_value):
    nsec = agent.get("private_key_nsec")
    key = pubkey(decode_nsec(nsec))
    relay = agent.get("relay_url")
    parsed = urlparse(relay if isinstance(relay, str) else "")
    if parsed.scheme not in ("ws", "wss") or not parsed.netloc or parsed.username or parsed.password:
        fail("relay_url must be a valid ws or wss URL")
    launch = agent.get("launch")
    if not isinstance(launch, dict):
        fail("desktop-resolved launch data is required")
    owner = launch.get("owner_pubkey")
    if not isinstance(owner, str) or not HEX64.fullmatch(owner):
        fail("launch.owner_pubkey is required for intentional stop")
    if agent.get("provider", "").strip() == "relay-mesh":
        fail("relay-mesh agents cannot be deployed to SSH")
    merged = {}
    for name in ("policy_env", "env"):
        layer = launch.get(name, {})
        if not isinstance(layer, dict):
            fail("launch environment must be an object")
        for k, v in layer.items():
            if not isinstance(k, str) or not ENV_KEY.fullmatch(k) or not isinstance(v, str):
                fail("launch environment contains an invalid entry")
            if k.upper() == "BUZZ_ACP_NO_PRESENCE":
                fail("presence suppression is forbidden for remote agents")
        merged.update(layer)
    for key_name in RESERVED:
        merged.pop(key_name, None)
    merged["BUZZ_RELAY_URL"] = relay
    merged["BUZZ_PRIVATE_KEY"] = nsec
    merged["NOSTR_PRIVATE_KEY"] = nsec
    merged["BUZZ_ACP_AGENT_OWNER"] = owner.lower()
    tag = agent.get("auth_tag")
    if tag is not None:
        if not isinstance(tag, str) or not tag.strip():
            fail("auth_tag must be nonempty when supplied")
        merged["BUZZ_AUTH_TAG"] = tag.strip()
    agent_cmd = launch.get("command")
    if agent_cmd:
        merged["BUZZ_ACP_AGENT_COMMAND"] = command(agent_cmd, "launch.command", path_value)
    args = launch.get("args", [])
    if not isinstance(args, list) or any(not isinstance(a, str) or "," in a for a in args):
        fail("launch.args must be strings without commas")
    if args:
        merged["BUZZ_ACP_AGENT_ARGS"] = ",".join(args)
    mcp = shutil.which("buzz-dev-mcp", path=path_value)
    if mcp:
        merged["BUZZ_ACP_MCP_COMMAND"] = str(Path(mcp).resolve())
    respond = agent.get("respond_to")
    if respond is not None:
        if respond not in ("owner-only", "allowlist", "anyone", "nobody"):
            fail("invalid respond_to mode")
        merged["BUZZ_ACP_RESPOND_TO"] = respond
        if respond == "allowlist":
            allow = agent.get("respond_to_allowlist")
            if not isinstance(allow, list) or not allow or any(not isinstance(x, str) or not HEX64.fullmatch(x) for x in allow):
                fail("respond_to_allowlist must contain public keys")
            merged["BUZZ_ACP_RESPOND_TO_ALLOWLIST"] = ",".join(allow)
    profiles = {
        "HOME": work_dir / "home",
        "XDG_CONFIG_HOME": work_dir / "config",
        "XDG_CACHE_HOME": work_dir / "cache",
        "XDG_DATA_HOME": work_dir / "data",
        "BUZZ_AGENT_CONFIG_DIR": work_dir / "config" / "buzz-agent",
        "CODEX_HOME": work_dir / "config" / "codex",
        "CLAUDE_CONFIG_DIR": work_dir / "config" / "claude",
        "TMPDIR": work_dir / "tmp",
    }
    for name, directory in profiles.items():
        merged[name] = str(directory)
    merged["PATH"] = path_value
    merged["BUZZ_ACP_EXIT_AFTER_INACTIVITY"] = "7200"
    return key, merged

def stage_file(path, data, mode):
    if path.is_symlink():
        fail("managed path is a symlink")
    fd, name = tempfile.mkstemp(prefix=path.name + ".stage.", dir=str(path.parent))
    staged = Path(name)
    try:
        os.fchmod(fd, mode)
        with os.fdopen(fd, "wb") as out:
            out.write(data)
            out.flush()
            os.fsync(out.fileno())
        return staged
    except Exception:
        try:
            os.close(fd)
        except OSError:
            pass
        staged.unlink(missing_ok=True)
        raise

def install_staged(staged, path):
    if path.is_symlink():
        fail("managed path is a symlink")
    os.replace(staged, path)

def atomic(path, data, mode):
    staged = stage_file(path, data, mode)
    try:
        install_staged(staged, path)
    finally:
        staged.unlink(missing_ok=True)

def launchctl(*args):
    return subprocess.run(["/bin/launchctl", *args], capture_output=True, text=True, timeout=15)

def owned_plist(data, label, root, digest):
    try:
        value = plistlib.loads(data)
    except Exception:
        fail("existing managed plist is unreadable")
    args = value.get("ProgramArguments")
    if value.get("Label") != label or not isinstance(args, list) or len(args) != 5:
        fail("existing managed plist has a different owner")
    if args[2:] != ["run", str(root), digest]:
        fail("existing managed plist has a different owner")
    python_path = Path(args[0])
    helper_path = Path(args[1])
    historical = helper_path == root / "helper.py"
    immutable = (helper_path.parent == root / "helpers"
                 and re.fullmatch(r"helper-[0-9a-f]{20}-[0-9a-f]{16}\.py", helper_path.name))
    if not python_path.is_absolute() or not helper_path.is_absolute() or not (historical or immutable):
        fail("existing managed plist has a different owner")
    return args

def loaded_job_owned(status, plist_path, args):
    if status.returncode:
        return False
    path_match = re.search(r"(?m)^\s*path = (.+?)\s*$", status.stdout)
    if not path_match or path_match.group(1) != str(plist_path):
        return False
    for argument in args:
        if not re.search(r"(?m)^\s*" + re.escape(argument) + r"\s*$", status.stdout):
            return False
    return True

def inspect_job(domain, label, plist_path, args):
    try:
        status = launchctl("print", domain + "/" + label)
    except (subprocess.SubprocessError, OSError):
        return "unknown"
    if status.returncode == 113:
        return "absent"
    if status.returncode:
        return "unknown"
    return "owned" if loaded_job_owned(status, plist_path, args) else "mismatch"

def unload_stopped_job(domain, label, plist_path, args):
    try:
        result = launchctl("bootout", domain + "/" + label)
    except (subprocess.SubprocessError, OSError):
        result = None
    outcome = inspect_job(domain, label, plist_path, args)
    if outcome == "absent":
        return
    if outcome == "owned":
        fail("could not unload stopped managed job")
    raise RecoveryRequired(RECOVERY_ERROR)

def bootstrap_owned_job(domain, label, plist_path, args):
    try:
        result = launchctl("bootstrap", domain, str(plist_path))
    except (subprocess.SubprocessError, OSError):
        result = None
    if result is not None and result.returncode == 0:
        return
    outcome = inspect_job(domain, label, plist_path, args)
    if outcome == "owned":
        return
    if outcome == "absent":
        fail("launchd could not bootstrap the managed job")
    raise RecoveryRequired(RECOVERY_ERROR)

def require_replacement_absent(domain, label, plist_path, args):
    outcome = inspect_job(domain, label, plist_path, args)
    if outcome == "absent":
        return
    if outcome != "owned":
        raise RecoveryRequired(RECOVERY_ERROR)
    try:
        launchctl("bootout", domain + "/" + label)
    except (subprocess.SubprocessError, OSError):
        pass
    if inspect_job(domain, label, plist_path, args) != "absent":
        raise RecoveryRequired(RECOVERY_ERROR)

def confirm_running(domain, label, plist_path, args):
    deadline = time.monotonic() + START_TIMEOUT_SECONDS
    stable_since = None
    stable_pid = None
    while time.monotonic() < deadline:
        status = launchctl("print", domain + "/" + label)
        if status.returncode:
            fail("launchd did not retain the managed job")
        if not loaded_job_owned(status, plist_path, args):
            raise RecoveryRequired(RECOVERY_ERROR)
        state = re.search(r"(?m)^\s*state = (\S+)\s*$", status.stdout)
        pid = re.search(r"(?m)^\s*pid = ([0-9]+)\s*$", status.stdout)
        if state and state.group(1) == "running" and pid and int(pid.group(1)) > 0:
            current_pid = pid.group(1)
            if stable_pid != current_pid:
                stable_pid = current_pid
                stable_since = time.monotonic()
            if time.monotonic() - stable_since >= START_STABILITY_SECONDS:
                return
        elif state and state.group(1) in ("exited", "stopped"):
            fail("managed runtime exited during startup")
        else:
            stable_since = None
            stable_pid = None
        time.sleep(0.02)
    fail("managed runtime did not become stably running")

def restore_stopped_job(domain, plist_path, old_plist):
    value = plistlib.loads(old_plist)
    label = value["Label"]
    args = value["ProgramArguments"]
    value["RunAtLoad"] = False
    atomic(plist_path, plistlib.dumps(value), 0o600)
    try:
        try:
            launchctl("bootstrap", domain, str(plist_path))
        except (subprocess.SubprocessError, OSError):
            pass
    finally:
        atomic(plist_path, old_plist, 0o600)
    outcome = inspect_job(domain, label, plist_path, args)
    if outcome == "owned":
        return
    if outcome == "absent":
        fail("prior managed job could not be restored")
    raise RecoveryRequired(RECOVERY_ERROR)

def deploy(req):
    cfg = req.get("provider_config")
    agent = req.get("agent")
    if not isinstance(cfg, dict) or not isinstance(agent, dict):
        fail("deploy requires agent and provider_config objects")
    if set(cfg) - {"host", "remote_directory", "runtime_command"}:
        fail("unsupported provider configuration field")
    root = safe_root(cfg.get("remote_directory"))
    path_value = deployment_path()
    runtime = command(cfg.get("runtime_command", "buzz-acp"), "runtime_command",
                      path_value, allow_absolute=True)
    identity = pubkey(decode_nsec(agent.get("private_key_nsec")))
    relay = agent.get("relay_url")
    parsed = urlparse(relay if isinstance(relay, str) else "")
    if parsed.scheme not in ("ws", "wss") or not parsed.netloc or parsed.username or parsed.password:
        fail("relay_url must be a valid ws or wss URL")
    digest = hashlib.sha256((relay + "\0" + identity).encode()).hexdigest()[:20]
    label = "local.buzz.ssh." + digest
    domain = "gui/" + str(os.getuid())
    work_dir = root / "work" / digest
    checked_identity, env = env_for(agent, work_dir, path_value)
    if checked_identity != identity:
        fail("invalid agent identity")
    preflight_executable(runtime, env, "runtime_command")
    if "BUZZ_ACP_AGENT_COMMAND" in env:
        preflight_executable(env["BUZZ_ACP_AGENT_COMMAND"], env, "launch.command")
    if "BUZZ_ACP_MCP_COMMAND" in env:
        preflight_executable(env["BUZZ_ACP_MCP_COMMAND"], env, "buzz-dev-mcp")
    if launchctl("print", domain).returncode:
        fail("launchd GUI domain is unavailable")

    root.mkdir(mode=0o700, exist_ok=True)
    state_dir = root / "state"
    job_dir = root / "jobs"
    log_dir = root / "logs"
    helper_dir = root / "helpers"
    directories = [state_dir, job_dir, log_dir, helper_dir, root / "work", work_dir]
    directories.extend(Path(env[name]) for name in
                       ("HOME", "XDG_CONFIG_HOME", "XDG_CACHE_HOME", "XDG_DATA_HOME",
                        "BUZZ_AGENT_CONFIG_DIR", "CODEX_HOME", "CLAUDE_CONFIG_DIR", "TMPDIR"))
    for directory in directories:
        directory.mkdir(mode=0o700, parents=True, exist_ok=True)
        if (directory.is_symlink() or directory.stat().st_uid != os.getuid()
                or stat.S_IMODE(directory.stat().st_mode) & 0o077):
            fail("managed subdirectory is unsafe")

    lock = root / ("lock-" + digest)
    if lock.is_symlink():
        fail("managed lock is a symlink")
    lock_fd = os.open(lock, os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
    with os.fdopen(lock_fd, "rb+") as lock_file:
        fcntl.flock(lock_file, fcntl.LOCK_EX)
        state_path = state_dir / (digest + ".json")
        plist_path = job_dir / (label + ".plist")
        source = globals().get("_SOURCE")
        if not isinstance(source, bytes):
            fail("remote helper source missing")
        source_hash = hashlib.sha256(source).hexdigest()
        helper_path = helper_dir / ("helper-" + digest + "-" + source_hash[:16] + ".py")
        for managed in (state_path, plist_path, helper_path):
            if managed.is_symlink():
                fail("managed path is a symlink")

        record = {"owner": "buzz-backend-ssh-v1", "label": label, "relay": relay,
                  "pubkey": identity, "runtime": runtime, "env": env,
                  "root": str(root), "helper": str(helper_path)}
        encoded = json.dumps(record, sort_keys=True, separators=(",", ":")).encode()
        fingerprint = hashlib.sha256(encoded).hexdigest()
        for existing in (state_path, plist_path):
            if existing.exists() and (existing.stat().st_uid != os.getuid()
                                      or stat.S_IMODE(existing.stat().st_mode) & 0o077):
                fail("existing managed files are not private")
        old = state_path.read_bytes() if state_path.exists() else None
        old_plist = plist_path.read_bytes() if plist_path.exists() else None
        if (old is None) != (old_plist is None):
            fail("existing managed files are incomplete")
        old_args = None
        if old is not None:
            try:
                previous = json.loads(old)
            except (ValueError, UnicodeDecodeError):
                fail("existing managed state is unreadable")
            if previous.get("owner") != "buzz-backend-ssh-v1" or previous.get("label") != label:
                fail("existing managed state has a different owner")
            old_args = owned_plist(old_plist, label, root, digest)

        try:
            status = launchctl("print", domain + "/" + label)
        except (subprocess.SubprocessError, OSError):
            raise RecoveryRequired(RECOVERY_ERROR)
        if status.returncode == 113:
            loaded = False
        elif status.returncode == 0:
            loaded = True
        else:
            raise RecoveryRequired(RECOVERY_ERROR)
        if loaded and (old_args is None or not loaded_job_owned(status, plist_path, old_args)):
            fail("existing launchd label is not owned by this provider")
        running = loaded and re.search(r"(?m)^\s*state = running\s*$", status.stdout)
        if running:
            if hashlib.sha256(old).hexdigest() == fingerprint:
                return label
            fail("agent is already running with different configuration; stop it before redeploy")

        if helper_path.exists():
            if (not helper_path.is_file() or helper_path.stat().st_uid != os.getuid()
                    or stat.S_IMODE(helper_path.stat().st_mode) & 0o077
                    or helper_path.read_bytes() != source):
                fail("existing immutable helper is unsafe")
            helper_stage = None
        else:
            helper_stage = stage_file(helper_path, source, 0o600)
        plist = {"Label": label,
                 "ProgramArguments": [sys.executable, str(helper_path), "run", str(root), digest],
                 "WorkingDirectory": str(work_dir), "RunAtLoad": True, "KeepAlive": False,
                 "ProcessType": "Background"}
        state_stage = plist_stage = None
        try:
            state_stage = stage_file(state_path, encoded, 0o600)
            plist_stage = stage_file(plist_path, plistlib.dumps(plist), 0o600)
        except Exception:
            if helper_stage is not None:
                helper_stage.unlink(missing_ok=True)
            if state_stage is not None:
                state_stage.unlink(missing_ok=True)
            if plist_stage is not None:
                plist_stage.unlink(missing_ok=True)
            raise

        old_unloaded = False
        writes_started = False
        helper_created = False
        new_args = plist["ProgramArguments"]
        try:
            if loaded:
                unload_stopped_job(domain, label, plist_path, old_args)
                old_unloaded = True
            writes_started = True
            if helper_stage is not None:
                install_staged(helper_stage, helper_path)
                helper_created = True
            install_staged(state_stage, state_path)
            install_staged(plist_stage, plist_path)
            bootstrap_owned_job(domain, label, plist_path, new_args)
            confirm_running(domain, label, plist_path, new_args)
        except RecoveryRequired:
            raise
        except Exception:
            if not writes_started:
                raise
            require_replacement_absent(domain, label, plist_path, new_args)
            try:
                if old is None:
                    state_path.unlink(missing_ok=True)
                    plist_path.unlink(missing_ok=True)
                else:
                    atomic(state_path, old, 0o600)
                    atomic(plist_path, old_plist, 0o600)
                if helper_created:
                    helper_path.unlink(missing_ok=True)
                if old_unloaded:
                    restore_stopped_job(domain, plist_path, old_plist)
            except RecoveryRequired:
                raise
            except Exception:
                fail("deployment failed and prior managed job could not be restored")
            raise
        finally:
            for staged in (helper_stage, state_stage, plist_stage):
                if staged is not None:
                    staged.unlink(missing_ok=True)
    return label

def run(root_value, digest):
    if not re.fullmatch(r"[0-9a-f]{20}", digest):
        fail("invalid managed id")
